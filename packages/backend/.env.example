# 后端端口
PORT=3001

# 绑定地址 (留空则监听所有网卡)
# HOST=0.0.0.0

# 开发模式下的前端地址 (仅用于 OAuth 回调跳转)
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_ORIGIN=http://localhost:3001

# GitHub OAuth (不配置则进入开发模式, 自动登录 local-dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/auth/github/callback

# 数据库文件路径
DB_PATH=data.db

# 竞技对战回合间隔 (毫秒)
TURN_INTERVAL_MS=800

# 单人验证全局并发上限 (默认按 CPU 核心数, 上限 32)
# SINGLE_MAX_CONCURRENT=

# 单人验证每用户每分钟提交上限 (0 = 不限流)
# SINGLE_SUBMIT_LIMIT_PER_MIN=0

# esbuild.wasm 远程地址 (单独部署时配置)
# ESBUILD_WASM_URL=https://cdn.example.com/esbuild.wasm

# 前端静态目录覆盖 (自动探测失败时使用)
# FRONTEND_DIST=